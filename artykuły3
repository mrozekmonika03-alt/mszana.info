        solectwo: solectwo,
        priorytety: priorytety,
        pomysl: pomysl ? pomysl.value.trim() : '',
        zebranie: zebranie,
        ts: Date.now()
      };
      try{
        await fetch(SUPA_URL + '/rest/v1/ankieta_fundusz', {
          method: 'POST',
          headers: { 'apikey': SUPA_KEY, 'Authorization': 'Bearer ' + SUPA_KEY, 'Content-Type': 'application/json', 'Prefer': 'return=minimal' },
          body: JSON.stringify(payload)
        });
      }catch(e2){ console.warn('Ankieta: zapis w chmurze nieudany', e2); }
      document.getElementById('ankietaFormWrap').classList.add('hidden');
      document.getElementById('ankOk').classList.remove('hidden');
    }finally{
      if(btn){ btn.disabled = false; btn.textContent = '📨 Wyślij ankietę'; }
    }
  });
})();

