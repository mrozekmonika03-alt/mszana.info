(function(){
  const SUPA_URL = 'https://batkjqjtwfduyonvjtym.supabase.co';
  const SUPA_KEY = 'sb_publishable_gUtHCxb0ICrRwqasoV766Q_C10nonpc';
  let solectwo = '';
  const priorytety = [];
  let zebranie = '';

  const btnSolectwo = document.querySelectorAll('[data-ank-solectwo]');
  const btnPri = document.querySelectorAll('[data-ank-priorytet]');
  const btnZeb = document.querySelectorAll('[data-ank-zebranie]');
  const counter = document.getElementById('ankPriorytetCount');

  function markBtn(btn, active){
    if(active){ btn.classList.add('bg-amber-500','text-white','border-amber-500'); }
    else { btn.classList.remove('bg-amber-500','text-white','border-amber-500'); }
  }

  btnSolectwo.forEach(b => b.addEventListener('click', () => {
    solectwo = b.getAttribute('data-ank-solectwo');
    btnSolectwo.forEach(x => markBtn(x, x === b));
  }));

  btnPri.forEach(b => b.addEventListener('click', () => {
    const val = b.getAttribute('data-ank-priorytet');
    const idx = priorytety.indexOf(val);
    if(idx >= 0){ priorytety.splice(idx, 1); markBtn(b, false); }
    else if(priorytety.length < 3){ priorytety.push(val); markBtn(b, true); }
    if(counter) counter.textContent = '(' + priorytety.length + '/3)';
  }));

  btnZeb.forEach(b => b.addEventListener('click', () => {
    zebranie = b.getAttribute('data-ank-zebranie');
    btnZeb.forEach(x => markBtn(x, x === b));
  }));

  const pomysl = document.getElementById('ankPomysl');
  const pc = document.getElementById('ankPomyslCount');
  if(pomysl && pc) pomysl.addEventListener('input', () => { pc.textContent = pomysl.value.length + '/500'; });

  const form = document.getElementById('ankietaForm');
  if(form) form.addEventListener('submit', async function(ev){
    ev.preventDefault();
    const err = document.getElementById('ankErr');
    if(!solectwo || priorytety.length === 0){
      if(err) err.classList.remove('hidden');
      return;
    }
    if(err) err.classList.add('hidden');
    const btn = document.getElementById('ankSubmit');
    if(btn){ btn.disabled = true; btn.textContent = '⏳ Wysyłanie...'; }
    try{
      const payload = {
        solectwo: solectwo,
        priorytety: priorytety,
        pomysl: pomysl ? pomysl.value.trim() : '',
        zebranie: zebranie,
        ts: Date.now()
      };
      try{
        await fetch(SUPA_URL + '/rest/v1/ankieta_fundusz', {
          method: 'POST',
          headers: { 'apikey': SUPA_KEY, 'Authorization': 'Bearer ' + SUPA_KEY, 'Content-Type': 'application/json', 'Prefer': 'return=minimal' },
          body: JSON.stringify(payload)
        });
      }catch(e2){ console.warn('Ankieta: zapis w chmurze nieudany', e2); }
      document.getElementById('ankietaFormWrap').classList.add('hidden');
      document.getElementById('ankOk').classList.remove('hidden');
    }finally{
      if(btn){ btn.disabled = false; btn.textContent = '📨 Wyślij ankietę'; }
    }
  });
})();

