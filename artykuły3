<script>

// ===== O NAS - rozwijanie =====
function toggleOnas(){
  const content = document.getElementById('onasContent');
  const arrow = document.getElementById('onasArrow');
  const btn = document.querySelector('#onas button');
  if(!content) return;
  const isHidden = content.classList.contains('hidden');
  content.classList.toggle('hidden', !isHidden);
  if(arrow) arrow.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
  if(btn) btn.setAttribute('aria-expanded', String(isHidden));
  if(isHidden) content.scrollIntoView({ behavior: 'smooth', block: 'start' });
}


// ===== CZAT: ASYSTENT MIESZKAŃCA =====
function openChat(e){
  if(e) e.preventDefault();
  const p = document.getElementById('chatPanel');
  if(p) p.classList.remove('hidden');
  if(p) p.scrollIntoView({behavior:'smooth', block:'center'});
}
function toggleChat(){
  const p = document.getElementById('chatPanel');
  if(!p) return;
  const hidden = p.classList.contains('hidden');
  p.classList.toggle('hidden', !hidden);
}
const chatFormEl = document.getElementById('chatForm');
if(chatFormEl) chatFormEl.addEventListener('submit', async function(ev){
  ev.preventDefault();
  const imie = document.getElementById('chatImie').value.trim();
  const nazwisko = document.getElementById('chatNazwisko').value.trim();
  const email = document.getElementById('chatEmail').value.trim();
  const wiadomosc = document.getElementById('chatWiadomosc').value.trim();
  const btn = document.getElementById('chatSubmit');
  const msg = document.getElementById('chatMsg');
  if(!imie || !nazwisko || !email || !wiadomosc) return;
  btn.disabled = true; btn.textContent = '⏳ Wysyłanie...';
  try{
    // 1) zapis w chmurze (Supabase) — kopia wiadomości
    try{
      await fetch('https://batkjqjtwfduyonvjtym.supabase.co/rest/v1/kontakt_widget', {
        method: 'POST',
        headers: {
          'apikey': 'sb_publishable_gUtHCxb0ICrRwqasoV766Q_C10nonpc',
          'Authorization': 'Bearer sb_publishable_gUtHCxb0ICrRwqasoV766Q_C10nonpc',
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify({ imie: imie, nazwisko: nazwisko, email: email, wiadomosc: wiadomosc, ts: Date.now() })
      });
    }catch(err){ console.warn('Zapis w chmurze nieudany:', err); }

    // 2) wysyłka e-mail na kontakt@mszana.info (FormSubmit AJAX)
    try{
      const r = await fetch('https://formsubmit.co/ajax/kontakt@mszana.info', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          _subject: '🧭 Asystent mieszkańca — wiadomość od ' + imie + ' ' + nazwisko,
          _template: 'table',
          imie: imie,
          nazwisko: nazwisko,
          email: email,
          wiadomosc: wiadomosc,
          _replyto: email
        })
      });
      if(!r.ok) throw new Error('HTTP ' + r.status);
    }catch(err){
      console.warn('E-mail nie wysłany przez FormSubmit:', err);
    }
  }finally{
    btn.disabled = false; btn.textContent = '📨 Wyślij wiadomość';
  }
  // pokaż potwierdzenie
  document.getElementById('chatForm').classList.add('hidden');
  if(msg) msg.classList.remove('hidden');
});


// ===== ANKIETA: FUNDUSZ SOŁECKI =====
(function(){
  const SUPA_URL = 'https://batkjqjtwfduyonvjtym.supabase.co';
  const SUPA_KEY = 'sb_publishable_gUtHCxb0ICrRwqasoV766Q_C10nonpc';
  let solectwo = '';
  const priorytety = [];
  let zebranie = '';

  const btnSolectwo = document.querySelectorAll('[data-ank-solectwo]');
  const btnPri = document.querySelectorAll('[data-ank-priorytet]');
  const btnZeb = document.querySelectorAll('[data-ank-zebranie]');
  const counter = document.getElementById('ankPriorytetCount');

  function markBtn(btn, active){
    if(active){ btn.classList.add('bg-amber-500','text-white','border-amber-500'); }
    else { btn.classList.remove('bg-amber-500','text-white','border-amber-500'); }
  }

  btnSolectwo.forEach(b => b.addEventListener('click', () => {
    solectwo = b.getAttribute('data-ank-solectwo');
    btnSolectwo.forEach(x => markBtn(x, x === b));
  }));

  btnPri.forEach(b => b.addEventListener('click', () => {
    const val = b.getAttribute('data-ank-priorytet');
    const idx = priorytety.indexOf(val);
    if(idx >= 0){ priorytety.splice(idx, 1); markBtn(b, false); }
    else if(priorytety.length < 3){ priorytety.push(val); markBtn(b, true); }
    if(counter) counter.textContent = '(' + priorytety.length + '/3)';
  }));

  btnZeb.forEach(b => b.addEventListener('click', () => {
    zebranie = b.getAttribute('data-ank-zebranie');
    btnZeb.forEach(x => markBtn(x, x === b));
  }));

  const pomysl = document.getElementById('ankPomysl');
  const pc = document.getElementById('ankPomyslCount');
  if(pomysl && pc) pomysl.addEventListener('input', () => { pc.textContent = pomysl.value.length + '/500'; });

  const form = document.getElementById('ankietaForm');
  if(form) form.addEventListener('submit', async function(ev){
    ev.preventDefault();
    const err = document.getElementById('ankErr');
    if(!solectwo || priorytety.length === 0){
      if(err) err.classList.remove('hidden');
      return;
    }
